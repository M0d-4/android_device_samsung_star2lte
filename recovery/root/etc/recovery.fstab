# Android fstab file.

# mount point  fstype device                                   device2              flags
/system         ext4   /dev/block/platform/11120000.ufs/by-name/SYSTEM        flags=display="System";wipeingui;backup=0
/system/product ext4   /dev/block/platform/11120000.ufs/by-name/SYSTEM/PRODUCT flags=display="Product";wipeingui;backup=0
/system/system_ext ext4   /dev/block/platform/11120000.ufs/by-name/SYSTEM/SYSTEM_EXT        flags=display="System_EXT";wipeingui;backup=0
/vendor         ext4   /dev/block/platform/11120000.ufs/by-name/VENDOR        flags=display="Vendor";wipeingui;backup=0
/odm            ext4   /dev/block/platform/11120000.ufs/by-name/ODM           flags=display="ODM";wipeingui;backup=0
/omr            ext4   /dev/block/platform/11120000.ufs/by-name/OMR           flags=display="OMR";wipeingui;backup=1

/boot           emmc   /dev/block/platform/11120000.ufs/by-name/BOOT
/recovery       emmc   /dev/block/platform/11120000.ufs/by-name/RECOVERY      flags=backup=1
/cache          ext4   /dev/block/platform/11120000.ufs/by-name/CACHE         flags=display="Cache"

/system_image   emmc   /dev/block/platform/11120000.ufs/by-name/SYSTEM        flags=backup=1;display="System Image";flashimg=1
/system_image/product_image emmc   /dev/block/platform/11120000.ufs/by-name/SYSTEM/PRODUCT flags=backup=1;display="Product Image";flashimg=1
/system_image/system_ext_image emmc   /dev/block/platform/11120000.ufs/by-name/SYSTEM/SYSTEM_EXT        flags=backup=1;display="System_EXT Image";flashimg=1
/vendor_image   emmc   /dev/block/platform/11120000.ufs/by-name/VENDOR        flags=backup=1;display="Vendor Image";flashimg=1
/odm_image      emmc   /dev/block/platform/11120000.ufs/by-name/ODM           flags=backup=1;display="ODM Image";flashimg=1

/data           ext4   /dev/block/platform/11120000.ufs/by-name/USERDATA      flags=encryptable=footer;length=-20480

/dqmdbg		emmc	/dev/block/platform/11120000.ufs/by-name/DQMDBG		flags=backup=1;display="DQMDBG Image";flashimg
/modem_debug	emmc	/dev/block/platform/11120000.ufs/by-name/CP_DEBUG	flags=backup=1;display="CPDEB (MODEM_DEBUG)";flashimg
/modem          emmc   /dev/block/platform/11120000.ufs/by-name/RADIO         flags=backup=1;display="Baseband"
/efs            ext4   /dev/block/platform/11120000.ufs/by-name/EFS           flags=backup=1;display="EFS"
/misc           emmc   /dev/block/platform/11120000.ufs/by-name/MISC          flags=display="Misc"
/preload        ext4   /dev/block/platform/11120000.ufs/by-name/HIDDEN        flags=display="Preload";wipeingui

/storage	auto    	/data/media/0                  		     	flags=backup=1;display="Internal Storage";usermrf;fsflags="bind,utf8";removable
/sdcard1	auto		/dev/block/mmcblk0p1	/dev/block/mmcblk1	flags=display="MicroSD Card";storage;wipeingui;removable
/usb_otg	auto    	/dev/block/sdg1       	/dev/block/sdh1         flags=fsflags=utf8;display="USB Storage";storage;wipeingui;removable

